{
  "version": 6,
  "configurePresets": [
    {
      "name": "default",
      "displayName": "Default Debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/default",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "OpenCV_DIR": "Z:/opencv/build/x64/vc16/lib"
      }
    },
    {
      "name": "local-vs",
      "displayName": "Local Visual Studio with Z:/opencv",
      "generator": "Visual Studio 18 2026",
      "binaryDir": "${sourceDir}/build/local-vs",
      "architecture": "x64",
      "cacheVariables": {
        "OpenCV_DIR": "Z:/opencv/build/x64/vc16/lib"
      }
    },
    {
      "name": "vs2022",
      "displayName": "Visual Studio 2022",
      "generator": "Visual Studio 17 2022",
      "binaryDir": "${sourceDir}/build/vs2022",
      "architecture": "x64",
      "cacheVariables": {
        "OpenCV_DIR": "Z:/opencv/build/x64/vc16/lib"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "default",
      "configurePreset": "default"
    },
    {
      "name": "local-vs",
      "configurePreset": "local-vs",
      "configuration": "Debug"
    },
    {
      "name": "vs2022",
      "configurePreset": "vs2022",
      "configuration": "Debug"
    }
  ]
}
